# =============================================================================
# Agent Secrets — service environment template
# =============================================================================
#
# THIS FILE MUST NEVER BE FILLED IN AND COMMITTED.
#
# It is a list of variable NAMES with obviously fake values. Copy it to `.env`
# — which .gitignore already excludes — and fill that copy in. If you ever find
# a real value in this file, treat it as a disclosed credential: rotate it
# first, then remove it. `pnpm scan:secrets` fails the commit either way.
#
# These variables are for the two long-running services (`apps/api` and
# `apps/telegram`). The CLI needs none of them: it keeps its device credential
# in the OS keychain, never in the environment.
# =============================================================================

# -----------------------------------------------------------------------------
# API service (apps/api) — serves the one-time secure input form
# -----------------------------------------------------------------------------

# Public origin used to build one-time URLs. Must be https outside development:
# the link travels through Telegram and must not be interceptable.
AGENT_SECRETS_PUBLIC_URL=https://secrets.example.invalid

# Bind address and port. Default to loopback; put a reverse proxy in front.
AGENT_SECRETS_HOST=127.0.0.1
AGENT_SECRETS_PORT=8787

# 'production' or 'development'. Never inferred — an unset value means production
# rules apply, including the https requirement above.
NODE_ENV=production

# Shared credential the Telegram adapter presents to POST /v1/requests.
# At least 32 characters. Generate with: openssl rand -hex 32
AGENT_SECRETS_ADAPTER_TOKEN=replace-with-a-generated-value-at-least-32-chars

# SQLite file holding one-time requests and the audit log. Never holds a value.
# Put it on a volume with 0700 permissions.
AGENT_SECRETS_DB_PATH=./data/agent-secrets.sqlite

# One-time link lifetime in seconds (30-900) and the maximum accepted value size.
AGENT_SECRETS_TTL_SECONDS=120
AGENT_SECRETS_MAX_VALUE_BYTES=65536

# Rate limiting: requests per source IP per window, and submission attempts
# allowed against a single request id before it is burned.
AGENT_SECRETS_RATE_LIMIT_MAX=20
AGENT_SECRETS_RATE_LIMIT_WINDOW_MS=60000
AGENT_SECRETS_MAX_ATTEMPTS=3

# Trust X-Forwarded-For. Only 'true' behind a reverse proxy you control:
# otherwise a client spoofs its own IP and walks through the rate limiter.
AGENT_SECRETS_TRUST_PROXY=false

# -----------------------------------------------------------------------------
# Bitwarden Secrets Manager backend (used by apps/api)
# -----------------------------------------------------------------------------

# Machine account access token. This is the credential that can read and write
# every secret in the project below — the most sensitive value on the host.
# Store it in the deployment platform's secret manager, not in a file on disk.
BWS_ACCESS_TOKEN=replace-with-the-machine-account-token

# Bitwarden project UUID the service is scoped to.
BWS_PROJECT_ID=00000000-0000-0000-0000-000000000000

# Optional: path to the `bws` binary and a self-hosted server URL.
BWS_EXECUTABLE_PATH=/usr/local/bin/bws
BWS_SERVER_URL=https://vault.bitwarden.com

# -----------------------------------------------------------------------------
# Telegram adapter (apps/telegram) — metadata only, never carries a value
# -----------------------------------------------------------------------------

# Bot token from @BotFather. Anyone holding it can impersonate the bot, so it is
# as sensitive as the adapter token.
TELEGRAM_BOT_TOKEN=000000000:replace-with-the-token-from-botfather

# Comma-separated numeric Telegram user ids allowed to talk to the bot. An empty
# allowlist means nobody: the adapter fails closed rather than serving everyone.
TELEGRAM_ALLOWED_USER_IDS=000000000,000000001

# Where the adapter reaches the API, and the credential it presents. This must be
# the same value as AGENT_SECRETS_ADAPTER_TOKEN above.
AGENT_SECRETS_API_URL=https://secrets.example.invalid
AGENT_SECRETS_ADAPTER_TOKEN=replace-with-a-generated-value-at-least-32-chars

# Optional webhook secret when running in webhook mode instead of long polling.
TELEGRAM_WEBHOOK_SECRET=replace-with-a-generated-value

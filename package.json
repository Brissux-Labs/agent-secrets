{
  "name": "agent-secrets-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Open-source secret broker for AI agents",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=22.11.0"
  },
  "scripts": {
    "build": "tsc --build",
    "demo": "node scripts/demo.mjs",
    "typecheck": "tsc --build --force",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:all": "vitest run",
    "test:watch": "vitest",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "clean": "tsc --build --clean",
    "verify": "pnpm lint && pnpm typecheck && pnpm test:all && pnpm scan:secrets"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@types/node": "22.20.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}

# Mirrors biome.json. When one changes, change the other: a formatter and an
# editor that disagree produce diff noise that hides real changes during review.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 100

# The Apache text is reproduced verbatim; reformatting or re-wrapping it would
# alter the license we are distributing.
[LICENSE]
trim_trailing_whitespace = false
max_line_length = off

[*.md]
trim_trailing_whitespace = false
max_line_length = off

[Makefile]
indent_style = tab

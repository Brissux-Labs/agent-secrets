# Registry and publication settings for the Agent Secrets workspace.
#
# Only npm-level keys live here. pnpm-specific workspace behaviour is declared in
# pnpm-workspace.yaml, which is the single source of truth for it; splitting the
# two avoids the failure mode where an install behaves differently depending on
# which file a contributor happened to edit.

registry=https://registry.npmjs.org/
@bx-labs:registry=https://registry.npmjs.org/

# Refuse to install under a Node version the packages do not declare support for.
# A security tool that silently runs on an unsupported runtime is a tool whose
# crypto and process-spawning behaviour has never been tested.
engine-strict=true

# Published packages are public scoped packages; each package.json also pins
# publishConfig.access, so a missing flag here can never make one private by
# accident.
access=public

# Sigstore provenance is attested at publish time. Outside a CI runner with an
# OIDC identity this makes `npm publish` fail rather than publish an
# unattested tarball — which is the intended behaviour: releases come from the
# release workflow, never from a laptop.
provenance=true

# Exact versions only. A caret range in a dependency of a secret broker means the
# reviewed dependency and the installed dependency can differ.
save-exact=true

# Dependency lifecycle scripts stay blocked unless the package is named in
# pnpm-workspace.yaml's `allowBuilds`; that is pnpm's default and it is load
# bearing here, so it is called out rather than configured away.
#
# `pnpm publish --tag` is always passed explicitly by the release workflow; no
# default dist-tag is configured here so that a mistyped command cannot quietly
# move `latest`.
